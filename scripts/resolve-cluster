#!/usr/bin/env bash

# Resolve the cluster owning the current ref from SPARK_K8S_CONFIG and print `export`
# lines on stdout. Exit 0 selected, 3 no ref to resolve, 1 invalid configuration.

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do # resolve $SOURCE until the file is no longer a symlink
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE" # if $SOURCE was a relative symlink, we need to resolve it relative to the path where the symlink file was located
done
DEPLOY_ROOT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
export DEPLOY_ROOT_DIR

# shellcheck disable=SC1091
source "$DEPLOY_ROOT_DIR/src/cluster-resolver.bash"

# Own process, so this trap cannot clobber the ones set by the CI before_script chain.
trap '[ -n "${RESOLVER_TMP_CONFIG_DIR:-}" ] && rm -rf "${RESOLVER_TMP_CONFIG_DIR}"' EXIT

resolve_cluster
